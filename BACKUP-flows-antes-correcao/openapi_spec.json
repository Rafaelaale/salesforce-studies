{
  "openapi": "3.0.0",
  "info": {
    "title": "PrevisaoDemandaAPI",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/prever": {
      "post": {
        "summary": "Realiza uma previsão de demanda",
        "operationId": "preverDemanda",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Recursos_Marketing": {
                    "type": "number"
                  },
                  "Eventos_Promocionais": {
                    "type": "number"
                  },
                  "Historico_Vendas_Mes_Anterior": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Previsão de demanda bem-sucedida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "previsao": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}