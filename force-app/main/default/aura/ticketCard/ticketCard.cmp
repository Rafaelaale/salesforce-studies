<aura:component access="global">
    <aura:attribute name="voo" type="Object" />
    <aura:attribute name="moeda" type="String" />
    <aura:attribute name="modo24h" type="Boolean" default="false" />

    <aura:registerEvent name="ticketEvent" type="c:ticketEventClick" />

    <lightning:card title="{!v.voo.Name}" class="slds-card_boundary">
        <aura:set attribute="actions">
            <lightning:button label="Selecionar" onclick="{!c.handleSelect}" />
        </aura:set>
        <p class="slds-p-horizontal_small">
            Origem: {!v.voo.AeroportoOrigem__r.Name} ({!v.voo.AeroportoOrigem__r.Sigla_C__c})<br/>
            Destino: {!v.voo.AeroportoDestino__r.Name} ({!v.voo.AeroportoDestino__r.Sigla_C__c})<br/>
            Data: {!v.voo.Data_de_Partida__c}<br/>
            Hora: {!v.voo.Hora_de_Partida__c}<br/>
            Preço: {!v.voo.Preco__c}
        </p>
    </lightning:card>
</aura:component>