<apex:page standardController="Account" recordSetVar="accounts" sidebar="false" showHeader="false">
    <apex:pageBlock title="Exercício: lista de contas">
        <apex:pageBlockTable value="{!accounts}" var="account">
            <apex:column headerValue="Nome" value="{!account.Name}" />
            <apex:column headerValue="Telefone" value="{!account.Phone}" />
            <apex:column headerValue="Setor" value="{!account.Industry}" />
        </apex:pageBlockTable>
    </apex:pageBlock>
</apex:page>